# This repository is vendored in exBASIC Studio. Keep files that are tracked
# by the ex800 repository visible to the parent repository even when the
# parent's generic build/output patterns would otherwise ignore them.
!/.github/
!/.github/**
!/.vscode/
!/.vscode/**
!/build/
!/build/**
!/ex800-1.0.0/.github/
!/ex800-1.0.0/.github/**
!/ex800-1.0.0/util/colormix.xex
!/ex800-1.0.0/util/colors.xex
!/ex800-1.0.0/util/hdevtest.lst
