# Extended DATA statements: DATA from files and DATA in ROM or other segments.

EXTERN {
 E_DATA_FILE
 E_DATA_SET_ROM_SEG
 E_DATA_SET_SEGMENT
}

# Reda DATA statements from a file:
DATA_FILE:
        "File" DATA_EXT_TYPE E_LABEL_SET_TYPE "\"" E_DATA_FILE

# Expands data types with "file" data
DATA_TYPE:
        TYPE_BYTE DATA_FILE
        TYPE_WORD DATA_FILE

# Reda DATA statements location (ROM or RAM):
DATA_EXT_TYPE:
        "ROM" E_DATA_SET_ROM_SEG
        "["   E_DATA_SET_SEGMENT "]"

# vi:syntax=perl
