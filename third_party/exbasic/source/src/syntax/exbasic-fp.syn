# exBASIC language, floating point support.

EXTERN {
 E_FCALL_F, E_ARG_FP, E_RET_FP, E_RET_VF
}

FP_FUNCS:<
        E_FCALL_F "(" FUNC_ARGS ")" E_FCALL_END

FUNC_ARG:
        E_ARG_FP FP_EXPR E_ARG_NEXT

FRET_VAL:
        E_RET_FP FP_EXPR E_RET_VF

# vi:syntax=perl
