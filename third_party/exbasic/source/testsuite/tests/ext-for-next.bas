' FOR/NEXT loops with all kinds of STEP and limits near overflow
S=0:N=0
FOR I=1 TO 10:S=S+I:N=N+1:NEXT
FOR I=10 TO 1 STEP -1:S=S*3+I:N=N+1:NEXT
FOR I=5 TO 4:S=S+1000:NEXT
FOR I=4 TO 5 STEP -1:S=S+1000:NEXT
FOR I=0 TO 0:S=S+7:NEXT
FOR I=-5 TO 5 STEP 2:S=S*3+I:NEXT
FOR I=5 TO -5 STEP -3:S=S*3+I:NEXT
? S;" ";N;" ";I
N=0:FOR I=32760 TO 32766:N=N+1:NEXT:? N;" ";I
N=0:FOR I=-32760 TO -32767 STEP -1:N=N+1:NEXT:? N;" ";I
FOR T=-3 TO 3
  IF T
    N=0:FOR I=-10 TO 10 STEP T:N=N*2+I:NEXT:? T;" ";N;" ";I
  ENDIF
NEXT
N=0:FOR I=1 TO 20:I=I+1:N=N+I:NEXT:? N;" ";I
N=0
FOR I=1 TO 5
  FOR J=I TO 5
    FOR K=J TO 1 STEP -1:N=N+I*J+K:NEXT
  NEXT
NEXT
? N
N=0:FOR I=1 TO 100:IF I=37 THEN EXIT
N=N+I:NEXT:? N;" ";I
L=5:N=0:FOR I=1 TO L:L=L+1:N=N+1:NEXT:? N;" ";L
